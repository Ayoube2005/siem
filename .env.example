# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in strong secrets. NEVER commit `.env`.
#   PowerShell: Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=siem
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=siem

# --- Backend database connection (async driver, points at the 'db' service) ---
DATABASE_URL=postgresql+asyncpg://siem:CHANGE_ME_strong_db_password@db:5432/siem

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin account, created on first startup only. CHANGE THE PASSWORD.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- CORS (comma-separated). The dockerised frontend proxies same-origin,
#     so this mainly matters for the Vite dev server on :5173 ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Detection tuning ---
BRUTEFORCE_THRESHOLD=5
BRUTEFORCE_WINDOW_SECONDS=300
SPRAY_DISTINCT_USERS=5
PORTSCAN_DISTINCT_PORTS=15
PORTSCAN_WINDOW_SECONDS=120

# --- AI triage (optional). Works offline with 'heuristic'. ---
# To use an LLM, set AI_PROVIDER=anthropic (or openai) and supply AI_API_KEY.
AI_ENABLED=true
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
